# Uygulamanın çalışacağı port
PORT=3000

# Etkinlik/albüm adı (sayfalarda gösterilir)
EVENT_NAME="Pelin & Yusuf'un Nişanı"

# Yayınlandığında bu uygulamaya ulaşılacak tam adres (QR kod ve masa kartları bunu kullanır)
# Örn: https://anilarimiz.example.com  (sonunda / OLMASIN)
PUBLIC_BASE_URL=https://nisan-9zq7.onrender.com

# Admin panel girişi (fotoğrafları onaylamak / tümünü indirmek için)
ADMIN_USER=admin
ADMIN_PASS=degistir-bu-sifreyi

# Yüklenecek dosyalar için limitler
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_UPLOAD=10

# true yaparsan yüklenen fotoğraflar admin onaylamadan galeride görünmez
REQUIRE_MODERATION=false

# ---------------------------------------------------------------------------
# DEPOLAMA SÜRÜCÜSÜ
# ---------------------------------------------------------------------------
# local  -> Dosyalar uploads/ klasöründe, bilgiler SQLite'ta tutulur.
#           Kalıcı diski olan bir VPS'te çalıştırırken kullan (bkz. README "Seçenek A").
# r2     -> Dosyalar Cloudflare R2'de, bilgiler Cloudflare D1'de tutulur.
#           Render/Railway gibi diski kalıcı OLMAYAN ücretsiz platformlarda kullan
#           (bkz. README "Seçenek B"). Aşağıdaki CF_*/R2_* değişkenlerini doldurman gerekir.
STORAGE_DRIVER=local

# --- STORAGE_DRIVER=r2 iken gerekli ---

# Cloudflare hesap ID'n (dashboard'da sağ alt köşede "Account ID" yazar)
CF_ACCOUNT_ID=

# Cloudflare dashboard > My Profile > API Tokens'tan oluşturulan, en az
# "D1: Edit" izni olan bir API token (Account Resources: kendi hesabın)
CF_API_TOKEN=

# R2 > "Manage R2 API Tokens"tan oluşturulan S3-uyumlu erişim anahtarları
# (CF_API_TOKEN'dan farklıdır!)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2 bucket adı (Cloudflare dashboard'da R2 > Create bucket ile oluştur)
R2_BUCKET_NAME=ani-albumu

# Bucket ayarlarından "Public Development URL"i aç, buraya yapıştır (sonunda / OLMASIN)
# Örn: https://pub-xxxxxxxxxxxxxxxx.r2.dev
R2_PUBLIC_URL=

# D1 > Create database ile oluşturduğunda verilen veritabanı ID'si
CF_D1_DATABASE_ID=
