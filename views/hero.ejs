<header class="hero">
  <div class="ornament" aria-hidden="true">
    <span class="ornament-line"></span>
    <svg class="ornament-mark" width="18" height="18" viewBox="0 0 24 24" fill="none">
      <path d="M12 21s-7.5-4.6-10-9.2C0.3 8.1 2 4 6 4c2.3 0 4 1.4 6 4 2-2.6 3.7-4 6-4 4 0 5.7 4.1 4 7.8-2.5 4.6-10 9.2-10 9.2z" fill="currentColor"/>
    </svg>
    <span class="ornament-line"></span>
  </div>
  <h1><%= eventName %></h1>
  <% if (typeof eventDate !== 'undefined' && eventDate) { %>
    <p class="hero-date"><%= eventDate %></p>
  <% } %>
  <% if (typeof heroSubtitle !== 'undefined' && heroSubtitle) { %>
    <p class="hero-subtitle"><%= heroSubtitle %></p>
  <% } %>
</header>
