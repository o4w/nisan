<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1" />
  <title><%= eventName %> — Anı Albümü</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;1,600&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="wrap">
    <%- include('partials/hero', { eventName, eventDate, heroSubtitle: 'Çektiğin fotoğraf ve videoları bizimle paylaş' }) %>

    <div class="card">
      <form action="/upload" method="POST" enctype="multipart/form-data" id="uploadForm">
        <label for="guest_name">Adın (opsiyonel)</label>
        <input type="text" id="guest_name" name="guest_name" placeholder="Örn. Ayşe Yılmaz" maxlength="80" />

        <label for="message">Kısa bir not bırak (opsiyonel)</label>
        <textarea id="message" name="message" placeholder="Sizi çok seviyoruz!" maxlength="300"></textarea>

        <label class="file-drop" id="dropLabel">
          <span class="big">📷 Fotoğraf / Video Seç</span>
          <span class="muted">Aynı anda en fazla <%= maxFiles %> dosya, dosya başına <%= maxSize %>MB'a kadar</span>
          <input type="file" name="photos" id="fileInput" accept="image/*,video/*" multiple required />
        </label>

        <div id="preview"></div>

        <div class="progress-wrap" id="progressWrap">
          <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
          <div class="progress-label" id="progressLabel">Yükleniyor... %0</div>
        </div>

        <button type="submit" id="submitBtn">Yükle</button>
      </form>
    </div>

    <p class="center muted" style="margin-top:18px;">
      <a href="/galeri" class="muted">Şimdiye kadar paylaşılanları gör →</a>
    </p>
  </div>

  <script>
    const fileInput = document.getElementById('fileInput');
    const preview = document.getElementById('preview');
    const form = document.getElementById('uploadForm');
    const submitBtn = document.getElementById('submitBtn');
    const dropLabel = document.getElementById('dropLabel');
    const progressWrap = document.getElementById('progressWrap');
    const progressFill = document.getElementById('progressFill');
    const progressLabel = document.getElementById('progressLabel');

    // iPhone fotoğrafları genelde HEIC formatında gelir; tarayıcı bunu doğrudan
    // gösteremez, o yüzden önizlemede kırık resim yerine küçük bir simge gösteriyoruz.
    // Gerçek dönüştürme, sunucuya göndermeden hemen önce (submit sırasında) yapılıyor.
    function isHeicFile(file) {
      const type = (file.type || '').toLowerCase();
      if (type === 'image/heic' || type === 'image/heif') return true;
      return /\.(heic|heif)$/i.test(file.name || '');
    }

    fileInput.addEventListener('change', () => {
      preview.innerHTML = '';
      [...fileInput.files].forEach((file) => {
        if (isHeicFile(file)) {
          const ph = document.createElement('div');
          ph.className = 'preview-heic';
          ph.textContent = '📷 HEIC';
          preview.appendChild(ph);
          return;
        }
        const url = URL.createObjectURL(file);
        const el = file.type.startsWith('video/')
          ? Object.assign(document.createElement('video'), { src: url, muted: true })
          : Object.assign(document.createElement('img'), { src: url });
        preview.appendChild(el);
      });
    });

    // heic2any kütüphanesini sadece gerçekten HEIC dosyası varsa (talep üzerine)
    // yüklüyoruz - böylece normal jpg/png yükleyen misafirler gereksiz yere
    // 1.3MB'lık bir kütüphane indirmiyor.
    let heic2anyPromise = null;
    function loadHeic2Any() {
      if (window.heic2any) return Promise.resolve(window.heic2any);
      if (heic2anyPromise) return heic2anyPromise;
      heic2anyPromise = new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = '/vendor/heic2any.min.js';
        script.onload = () => resolve(window.heic2any);
        script.onerror = () => reject(new Error('heic2any yuklenemedi'));
        document.head.appendChild(script);
      });
      return heic2anyPromise;
    }

    // HEIC dosyalarını yüklemeden ÖNCE, telefonun kendi gücüyle (sunucu değil)
    // JPEG'e çeviriyoruz. Böylece kısıtlı kaynaklı sunucunun bu ağır işlemi
    // yapmasına hiç gerek kalmıyor - "bazen kırık resim" sorununun asıl kaynağı
    // buydu (büyük HEIC fotoğrafların dönüştürülmesi sunucunun belleğini zorluyordu).
    async function prepareFilesForUpload(files, setStatus) {
      if (!files.some(isHeicFile)) return files;

      setStatus('HEIC fotoğraf(lar) dönüştürülüyor...');
      let heic2any;
      try {
        heic2any = await loadHeic2Any();
      } catch (e) {
        console.error('heic2any yuklenemedi, dosyalar oldugu gibi gonderilecek:', e);
        return files; // sunucudaki yedek mekanizma devreye girer
      }

      const prepared = [];
      for (const file of files) {
        if (!isHeicFile(file)) {
          prepared.push(file);
          continue;
        }
        try {
          const result = await heic2any({ blob: file, toType: 'image/jpeg', quality: 0.9 });
          const blob = Array.isArray(result) ? result[0] : result;
          const newName = file.name.replace(/\.[^.]+$/, '') + '.jpg';
          prepared.push(new File([blob], newName, { type: 'image/jpeg' }));
        } catch (e) {
          console.error('HEIC donusturme basarisiz, orijinal dosya gonderilecek:', e);
          prepared.push(file);
        }
      }
      return prepared;
    }

    // Dosyaları sürükleyip bırakma için görsel geri bildirim + gerçek atama
    ['dragenter', 'dragover'].forEach((evt) => {
      dropLabel.addEventListener(evt, (e) => {
        e.preventDefault();
        dropLabel.classList.add('drag-over');
      });
    });
    ['dragleave', 'drop'].forEach((evt) => {
      dropLabel.addEventListener(evt, (e) => {
        e.preventDefault();
        dropLabel.classList.remove('drag-over');
      });
    });
    dropLabel.addEventListener('drop', (e) => {
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length) {
        fileInput.files = e.dataTransfer.files;
        fileInput.dispatchEvent(new Event('change'));
      }
    });

    // Gerçek yükleme yüzdesini göstermek için form'u XHR ile gönderiyoruz
    // (native form submit'te tarayıcı ilerleme bilgisi vermiyor).
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Hazırlanıyor...';
      progressWrap.classList.add('show');
      progressFill.classList.add('indeterminate');
      progressLabel.textContent = 'Hazırlanıyor...';

      let filesToSend;
      try {
        filesToSend = await prepareFilesForUpload([...fileInput.files], (msg) => {
          progressLabel.textContent = msg;
        });
      } catch (err) {
        filesToSend = [...fileInput.files];
      }

      const formData = new FormData();
      formData.append('guest_name', form.guest_name.value);
      formData.append('message', form.message.value);
      filesToSend.forEach((file) => formData.append('photos', file));

      submitBtn.textContent = 'Yükleniyor...';
      progressFill.classList.remove('indeterminate');
      progressFill.style.width = '0%';
      progressLabel.textContent = 'Yükleniyor... %0';

      const xhr = new XMLHttpRequest();
      xhr.open('POST', '/upload');
      xhr.upload.addEventListener('progress', (ev) => {
        if (ev.lengthComputable) {
          const pct = Math.round((ev.loaded / ev.total) * 100);
          progressFill.style.width = pct + '%';
          progressLabel.textContent = pct < 100 ? `Yükleniyor... %${pct}` : 'İşleniyor...';
        }
      });
      xhr.onload = () => {
        document.open();
        document.write(xhr.responseText);
        document.close();
      };
      xhr.onerror = () => {
        progressLabel.textContent = 'Bağlantı hatası oluştu, lütfen tekrar dene.';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Yükle';
      };
      xhr.send(formData);
    });
  </script>
</body>
</html>
