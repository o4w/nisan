<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= eventName %> — Anı Albümü</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;1,600&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="wrap">
    <%- include('partials/hero', { eventName, eventDate: typeof eventDate !== 'undefined' ? eventDate : null }) %>

    <div class="card center">
      <% if (success) { %>
        <div class="result-icon">🎉</div>
        <h2>Teşekkürler!</h2>
        <p class="muted">
          <%= count %> dosya albüme eklendi.
          <% if (moderated) { %>
            Onaylandıktan sonra galeride görünecek.
          <% } %>
        </p>
      <% } else { %>
        <div class="result-icon">😕</div>
        <h2>Bir sorun oluştu</h2>
        <p class="muted"><%= error %></p>
      <% } %>

      <a class="btn" href="/">Başka dosya yükle</a>
      <a class="btn btn-secondary" href="/galeri" style="margin-top:10px;">Galeriyi görüntüle</a>
    </div>
  </div>

  <% if (success) { %>
    <script>
      (function () {
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var emojis = ['🎉', '💛', '✨', '🤍', '🎊'];
        var count = 26;
        for (var i = 0; i < count; i++) {
          var piece = document.createElement('span');
          piece.className = 'confetti-piece';
          piece.textContent = emojis[Math.floor(Math.random() * emojis.length)];
          piece.style.left = Math.random() * 100 + 'vw';
          piece.style.animationDuration = (2.2 + Math.random() * 1.6) + 's';
          piece.style.animationDelay = (Math.random() * 0.7) + 's';
          piece.style.fontSize = (1 + Math.random() * 0.9) + 'rem';
          document.body.appendChild(piece);
          piece.addEventListener('animationend', function () { this.remove(); });
        }
      })();
    </script>
  <% } %>
</body>
</html>
